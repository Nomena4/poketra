generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int             @id @default(autoincrement())
  fullName             String?
  email                String          @unique
  password             String
  expenses             Expense[]
  incomes              Income[]
  receiptUploads       ReceiptUpload[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  budget               Decimal?        @default(0)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  avatar               String?
  caisseTransactions   CaisseTransaction[] @relation("UserCaisse")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ExpenseType {
  ONE_TIME
  RECURRING
}

model Expense {
  id              Int            @id @default(autoincrement())
  amount          Decimal
  date            DateTime?
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id])
  description     String?
  type            ExpenseType    @default(ONE_TIME)
  creationDate    DateTime       @default(now())
  startDate       DateTime?
  endDate         DateTime?
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  receiptUploadId Int?
  receiptUpload   ReceiptUpload? @relation(fields: [receiptUploadId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([type])
}


model Income {
  id           Int      @id @default(autoincrement())
  amount       Decimal
  date         DateTime
  source       String
  description  String?
  creationDate DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}

model ReceiptUpload {
  id          Int       @id @default(autoincrement())
  filename    String
  url         String
  contentType String
  size        Int
  uploadedAt  DateTime  @default(now())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  expense     Expense[]
}

// ==========================================
// CashPoint Modules
// ==========================================

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

model CaisseTransaction {
  id           Int             @id @default(autoincrement())
  type         TransactionType
  amount       Decimal
  operator     String          // MVola, Orange Money, Airtel Money, etc.
  commission   Decimal         @default(0)
  reference    String?
  description  String?
  date         DateTime        @default(now())
  userId       Int
  user         User            @relation("UserCaisse", fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}
